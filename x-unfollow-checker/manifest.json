{
  "manifest_version": 3,
  "name": "Quem não me segue de volta (X/Twitter)",
  "version": "1.0.0",
  "description": "Mostra quem você segue no X que não te segue de volta, e permite deixar de seguir manualmente, um perfil por vez.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Quem não me segue de volta"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "minimum_chrome_version": "102"
}
