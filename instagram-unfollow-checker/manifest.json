{
  "manifest_version": 3,
  "name": "Quem não me segue de volta (Instagram)",
  "version": "1.0.0",
  "description": "Mostra quem você segue no Instagram que não te segue de volta, e permite deixar de seguir manualmente, um perfil por vez.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://www.instagram.com/*"],
  "minimum_chrome_version": "102"
}
